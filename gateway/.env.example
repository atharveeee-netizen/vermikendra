# Canonical Configuration for Vermikendra Gateway

# MQTT Settings
VK_MQTT_BROKER=127.0.0.1
VK_MQTT_PORT=1883
VK_MQTT_USER=
VK_MQTT_PASSWORD=

# Database Settings
VK_DB_PATH=vermikendra.db

# API Server Settings
VK_API_HOST=0.0.0.0
VK_API_PORT=8000

# Site Configuration
VK_DEFAULT_SITE_ID=1

# Radio Settings (Fallback Modem)
VK_SERIAL_PORT=/dev/serial0
VK_BAUD_RATE=115200
